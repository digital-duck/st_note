{
  "table_name": "t_contacts",
  "display_name": "📇 Contacts",
  "description": "Contact and relationship management with Trinity framework integration",
  "icon": "📇",
  "menu_position": 3,
  "columns": [
    {
      "name": "id",
      "type": "INTEGER",
      "constraints": ["PRIMARY KEY", "AUTOINCREMENT"],
      "description": "Unique identifier"
    },
    {
      "name": "contact_name",
      "type": "TEXT",
      "constraints": ["NOT NULL"],
      "description": "Full name of the contact"
    },
    {
      "name": "company",
      "type": "TEXT",
      "constraints": [],
      "description": "Company or organization"
    },
    {
      "name": "title",
      "type": "TEXT",
      "constraints": [],
      "description": "Job title or role"
    },
    {
      "name": "email",
      "type": "TEXT",
      "constraints": [],
      "description": "Primary email address"
    },
    {
      "name": "phone",
      "type": "TEXT",
      "constraints": [],
      "description": "Primary phone number"
    },
    {
      "name": "linkedin_url",
      "type": "TEXT",
      "constraints": [],
      "description": "LinkedIn profile URL"
    },
    {
      "name": "expertise",
      "type": "TEXT",
      "constraints": [],
      "description": "Areas of expertise or skills"
    },
    {
      "name": "relationship_type",
      "type": "TEXT",
      "constraints": ["DEFAULT ''"],
      "description": "Type of relationship (colleague, client, mentor, etc.)"
    },
    {
      "name": "contact_status",
      "type": "TEXT",
      "constraints": ["DEFAULT 'active'"],
      "description": "Contact status (active, inactive, prospect)"
    },
    {
      "name": "notes",
      "type": "TEXT",
      "constraints": [],
      "description": "Additional notes and context"
    },
    {
      "name": "tags",
      "type": "TEXT",
      "constraints": [],
      "description": "Comma-separated tags"
    },
    {
      "name": "last_contact_date",
      "type": "TEXT",
      "constraints": [],
      "description": "Date of last interaction"
    },
    {
      "name": "is_active",
      "type": "INTEGER",
      "constraints": ["DEFAULT 1", "CHECK(is_active IN (0, 1))"],
      "description": "Active/inactive flag"
    },
    {
      "name": "created_at",
      "type": "TEXT",
      "constraints": [],
      "description": "Creation timestamp"
    },
    {
      "name": "updated_at",
      "type": "TEXT",
      "constraints": [],
      "description": "Last update timestamp"
    },
    {
      "name": "created_by",
      "type": "TEXT",
      "constraints": ["NOT NULL"],
      "description": "Creator user ID"
    },
    {
      "name": "updated_by",
      "type": "TEXT",
      "constraints": [],
      "description": "Last updater user ID"
    }
  ],
  "features": {
    "semantic_search": true,
    "import_export": true,
    "tag_management": true,
    "url_linking": true,
    "audit_trail": true,
    "relationship_mapping": true
  },
  "list_of_values": {
    "relationship_type": ["colleague", "client", "mentor", "vendor", "partner", "prospect", "others"],
    "contact_status": ["active", "inactive", "prospect", "archived"]
  },
  "trinity_domain": "People"
}